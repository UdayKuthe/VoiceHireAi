# ==============================================================================
# VoiceHire AI - Backend Environment Template (Phase 1, 2 & 3)
# ==============================================================================

# Server & Environment
PORT=5000
NODE_ENV=development

# Databases
MONGODB_URI=mongodb://127.0.0.1:27017/voicehire
REDIS_URL=redis://127.0.0.1:6379

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Groq (Primary Live Interview LLM Provider — gpt-oss reasoning models)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_ANALYSIS=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

# Google Gemini (Extraction & Fallback Provider)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Deepgram (Real-time Speech-to-Text & Text-to-Speech)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_TTS_MODEL=aura-asteria-en

# LiveKit WebRTC Audio Infrastructure
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# LLM Runtime & Resilience Controls (Optional)
LLM_TIMEOUT_MS=8000
LLM_COOLDOWN_SECONDS=60
MOCK_VOICE=false
